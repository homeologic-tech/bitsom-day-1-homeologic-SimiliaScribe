# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# ── Local providers (no key needed) ──────────────────────────────────────────
# Only needed if Ollama runs on a non-default host/port or a different tag.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma1.5:4b

# ── Optional cloud providers ─────────────────────────────────────────────────
# Read server-side only. Never sent to the browser. The UI can select which
# provider/model to use, but can never supply or see these values.

# Speech-to-text via Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Extraction + diagnosis via OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
